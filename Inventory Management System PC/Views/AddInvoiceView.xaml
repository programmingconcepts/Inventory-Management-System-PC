<Window x:Class="Inventory_Management_System_PC.Views.AddInvoiceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventory_Management_System_PC.Views"
        mc:Ignorable="d"
        Title="Add Invoice" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Supplier Selection -->
            <RowDefinition Height="Auto" />
            <!-- Item Entry -->
            <RowDefinition Height="*" />
            <!-- DataGrid -->
            <RowDefinition Height="Auto" />
            <!-- Total and Save Button -->
        </Grid.RowDefinitions>

        <!-- Row 1: Supplier Selection -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Margin="0,0,0,10">
            <TextBlock Text="Customer:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Width="80" />
            <ComboBox ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="CustomerName"
                      IsEditable="True"
                      StaysOpenOnEdit="True"
                      IsTextSearchEnabled="True"
                      Width="200" />

            <TextBlock Text="Phone:"
                       Margin="30 5, 5, 5" />
            <TextBox Text="{Binding PhoneNumber}" 
                     Width="100"
                     Margin="5"/>

            <TextBlock Text="Address:"
                       Margin="30 5, 5, 5" />
            <TextBox Text="{Binding Address}"
                     Width="200"
                     Margin="5" />

        </StackPanel>

        <!-- Row 2: Item Entry -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Margin="0,0,0,10">
            <TextBlock Text="Item:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Width="80" />
            <ComboBox ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="Name"
                      IsEditable="True"
                      StaysOpenOnEdit="True"
                      IsTextSearchEnabled="True"
                      Width="150"
                      Margin="0,0,10,0" />

            <TextBlock Text="Quantity "
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding MeasuringUnitText}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Width="50" />
            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     Width="80"
                     Margin="0,0,10,0" />

            <TextBlock Text="Sale Price:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Width="100" />
            <TextBox Text="{Binding SalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     Width="80" />

            <Button Content="Add Item"
                    Margin="10 0"
                    Command="{Binding AddInvoiceItemCommand}" />
        </StackPanel>

        <!-- Row 3: DataGrid for Added Items -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding InvoiceItems}"
                  AutoGenerateColumns="False"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item"
                                    Binding="{Binding Item.Name}"
                                    Width="*" />
                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity}"
                                    Width="80" />
                <DataGridTextColumn Header="Price"
                                    Binding="{Binding SalePrice}"
                                    Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 4: Total Supply Charges and Save Button -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="3"
                    HorizontalAlignment="Right">

            <TextBlock Text="Extra Charges:"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBox Text="{Binding ExtraCharges}"
                     Width="100"
                     Margin="5" />

            <TextBlock Text="Discount:"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBox Text="{Binding Discount}"
                     Width="100"
                     Margin="5" />

            <TextBlock Text="Paid:"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBox Text="{Binding PaidAmount}"
                     Width="100"
                     Margin="5" />

            <TextBlock Text="Total Amount:"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding InvoiceTotal}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="DarkGreen"
                       Margin="10,0" />
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Width="100"
                    Margin="20,0,0,0" />
        </StackPanel>

    </Grid>
</Window>
